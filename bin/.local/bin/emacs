#!/bin/sh
# /usr/local/bin/emacs symlinks into Emacs.app, which breaks Emacs's own
# self-location (lisp/libexec resolve relative to /usr/local/bin and fail).
# So run the real bundle binary directly, and route interactive edits into
# the shared daemon via emacsclient. Daemon/batch/debug flags stay standalone.
app=/Applications/Emacs.app/Contents/MacOS/Emacs
client=/Applications/Emacs.app/Contents/MacOS/bin/emacsclient

if [ -x "$app" ]; then
	for a in "$@"; do
		case "$a" in
		--batch | -batch | --script | -l | --load | --eval | \
			--daemon | --bg-daemon=* | --fg-daemon | --fg-daemon=* | \
			-Q | --quick | -q | --no-init-file | --version | --help)
			exec "$app" "$@"
			;;
		esac
	done
	exec "$client" -a '' -nw "$@"
fi

# Non-macOS: defer to the next emacs on PATH, skipping this wrapper.
IFS=:
for d in $PATH; do
	[ "$d" = "$HOME/.local/bin" ] && continue
	[ -x "$d/emacs" ] && exec "$d/emacs" "$@"
done
echo "emacs: no runnable emacs found on PATH" >&2
exit 127
