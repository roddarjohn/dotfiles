FROM qwen3.8:27b

# Qwen3 thinking-mode sampling (Qwen/unsloth recommendation). Base model ships temperature 1.
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0
PARAMETER presence_penalty 1.5
PARAMETER repeat_penalty 1

# Base 27b sets NO num_ctx -> Ollama would fall back to a tiny default and truncate agent
# context. 17GB weights leave more headroom than the 35b, but keep 131072 for stable memory
# use on a 51GB machine. Keep pi's models.json contextWindow in sync.
PARAMETER num_ctx 131072
PARAMETER num_predict 32768
